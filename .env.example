# Base de données Neon (PostgreSQL)
# Sur Vercel, ces deux variables sont créées par l'intégration Neon (Storage).
# En local, copiez-les depuis Vercel (Settings > Environment Variables) ou le tableau de bord Neon.
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://utilisateur:motdepasse@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret de signature des sessions admin : 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Compte administrateur créé par `npm run seed`
ADMIN_NAME="Justin-Laurent NZENGUI-MAYOMBO"
ADMIN_EMAIL="nzenguijustinlaurent@gmail.com"
ADMIN_PASSWORD=""

# Vercel Blob (logos, captures, CV). Vide en local : les fichiers vont dans public/uploads
BLOB_READ_WRITE_TOKEN=""
